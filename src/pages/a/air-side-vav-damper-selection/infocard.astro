---
// a/air-side-vav-damper-selection/infocard.astro — Infocard download page for LinkedIn/X sharing
import BaseLayout from '../../../layouts/BaseLayout.astro';

const pageTitle = "VAV Damper Selection — Infocard";
const pageDescription = "Editorial infocard: opposed-blade vs parallel-blade damper comparison, sizing methods from ASHRAE, BACnet/Modbus integration, and cross-border standards for Singapore, Hong Kong, and Dubai. 760×2561 PNG, optimised for LinkedIn Document Posts.";
const canonicalUrl = "https://ai.xinca.com/a/air-side-vav-damper-selection/infocard/";
const articleUrl = "https://ai.xinca.com/a/air-side-vav-damper-selection/";
const articleSlug = "air-side-vav-damper-selection";
const infocardImage = "/articles/infocards/vav-damper-selection-infocard.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://ai.xinca.com${infocardImage}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="text-xs text-[#666] mb-6">
      <a href="/" class="hover:text-[#2ea3f2]">Home</a> &rsaquo;
      <a href="/kb/air" class="hover:text-[#2ea3f2]">Air-side</a> &rsaquo;
      <a href={articleUrl} class="hover:text-[#2ea3f2]">VAV Damper Selection</a> &rsaquo;
      <span class="text-[#333]">Infocard</span>
    </nav>

    <!-- Preview Hero -->
    <section class="mb-8">
      <h1 class="text-2xl md:text-3xl font-extrabold text-[#333] mb-3 text-center" style="font-family:'Trebuchet MS',Trebuchet,Helvetica,Arial,Lucida,sans-serif">
        VAV Damper Selection — Infocard
      </h1>
      <p class="text-[#666] mb-6 text-sm text-center max-w-lg mx-auto">
        One-page editorial infocard for LinkedIn and X sharing. 760×2561 PNG — right-click to save, or use the download button below.
      </p>

      <!-- Download button -->
      <div class="text-center mb-6">
        <a href={infocardImage} download={`Infocard-ai-xinca-com-${articleSlug}.png`} class="inline-flex items-center gap-2 bg-[#3D5A80] text-white font-bold px-6 py-3 rounded-lg hover:bg-[#2d4a60] transition-colors text-base">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Download Infocard (PNG · 1.4 MB)
        </a>
      </div>

      <!-- Infocard Preview with Lightbox -->
      <div class="group relative rounded-lg overflow-hidden shadow-lg bg-white border border-[#e0e4e8] max-w-[760px] mx-auto cursor-zoom-in" onclick="openLightbox()">
        <img src={infocardImage} alt="VAV Damper Selection Infocard — Opposed-Blade vs Parallel-Blade, ASHRAE Sizing Methods, BACnet Integration, Cross-Border Standards" class="w-full h-auto" loading="lazy" />
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors pointer-events-none"></div>
      </div>
    </section>

    <!-- Back link + Share -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
      <a href={articleUrl} class="inline-flex items-center gap-2 text-sm bg-[#2ea3f2] text-white px-5 py-2.5 rounded-lg hover:bg-[#2589d9] transition-colors">
        &larr; Back to Full Article
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm bg-[#0a66c2] text-white px-5 py-2.5 rounded-lg hover:bg-[#095298] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        Share on LinkedIn
      </a>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-black/90 hidden flex-col items-center justify-center" role="dialog" aria-label="Infocard preview">
    <button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white text-2xl z-10" aria-label="Close">&times;</button>
    <img id="lightbox-img" src={infocardImage} alt="VAV Damper Selection Infocard" class="max-h-[95vh] max-w-[95vw] object-contain rounded-lg shadow-2xl" />
  </div>
</BaseLayout>

<script>
  function openLightbox() {
    document.getElementById('lightbox').classList.remove('hidden');
    document.getElementById('lightbox').classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  document.getElementById('lightbox').addEventListener('click', function(e) {
    if (e.target === this || e.target.id === 'lightbox-close') {
      this.classList.add('hidden');
      this.classList.remove('flex');
      document.body.style.overflow = '';
    }
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var lb = document.getElementById('lightbox');
      if (lb.classList.contains('flex')) {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }
  });
</script>
