---
// x/[slug].astro — X post catalog page (per fleet account)
import BaseLayout from '../../layouts/BaseLayout.astro';
import xPosts from '../../data/x-posts.json';

export function getStaticPaths() {
  return xPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const postUrl = `https://ai.xinca.com/x/${post.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SocialMediaPosting",
  "headline": post.title,
  "datePublished": post.date,
  "url": postUrl,
  "author": { "@type": "Organization", "name": "XINCA" },
  "publisher": { "@type": "Organization", "name": "XINCA", "url": "https://ai.xinca.com" },
  "sharedContent": { "@type": "CreativeWork", "text": post.text, "url": post.source }
};
---

<BaseLayout
  title={`${post.title} — X Post (${post.account})`}
  description={`X post by @${post.account}: ${post.text.slice(0, 140)}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <main class="min-h-screen bg-white">
    <article class="mx-auto max-w-2xl px-6 py-16">
      <p class="text-sm font-semibold uppercase tracking-wide text-sky-700">
        X post · @{post.account} · {post.date}
      </p>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">{post.title}</h1>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-6">
        <p class="whitespace-pre-line text-lg leading-relaxed text-slate-800">{post.text}</p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
        <a
          href={post.source}
          class="rounded-lg bg-sky-700 px-4 py-2 font-medium text-white hover:bg-sky-800"
        >
          Read the full article →
        </a>
        <a href="/x/" class="font-medium text-sky-700 hover:underline">All X posts</a>
      </div>
    </article>
  </main>
</BaseLayout>
