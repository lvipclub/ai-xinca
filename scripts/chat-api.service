[Unit]
Description=XINCA Havi Chat API
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/ai-xinca-chat
# 2026-09-07: mirrors the LIVE unit havi-chat-api.service on k16-vps (port 8090).
# Port 8080 is taken by docker-proxy; creds come from EnvironmentFile (deploy's
# .hermes .env), NOT from a shell-inherited OPENROUTER_API_KEY.
EnvironmentFile=/home/deploy/.hermes/.env
ExecStart=/usr/bin/python3 -m uvicorn chat_api:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target